# Application Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
# Note: When running with Docker Compose, use DB_HOST=mysql
# When running locally without Docker, use DB_HOST=localhost (or 127.0.0.1)
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=login_backend

# JWT Configuration
# Use strong, unique random secrets in production
JWT_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=*
