{
  "name": "login-backend",
  "version": "1.0.0",
  "description": "Internship Login Backend API built with Node.js, Express, MySQL 8, and JWT",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand"
  },
  "keywords": [
    "nodejs",
    "express",
    "mysql",
    "jwt",
    "authentication",
    "login-backend"
  ],
  "author": "Internship Project",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "joi": "^17.13.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.9.7"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "rootDir": ".",
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/*.test.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/node_modules"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "haste": {
      "enableSymlinks": false
    },
    "verbose": true,
    "testTimeout": 10000
  }
}
